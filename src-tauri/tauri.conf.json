{
  "productName": "DONUT",
  "version": "1.0.4",
  "identifier": "com.donut.app",
  "build": {
    "frontendDist": "../app/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DONUT",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"],
    "resources": {
      "../cli/scripts": "cli/scripts",
      "../cli/modules": "cli/modules",
      "../cli/config": "cli/config",
      "../templates": "templates"
    }
  },
  "plugins": {}
}
